# 统一行尾为 LF，避免 Windows(CRLF)/macOS(LF) 跨平台协作产生噪音 diff
* text=auto eol=lf

# 文本类文件显式按文本处理
*.{ts,tsx,js,jsx,mts,cjs,mjs,css,html,json,md,txt,yml,yaml} text eol=lf

# 二进制 / 打包产物：强制按二进制处理，不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.bmp binary
*.avif binary
*.ico binary
*.pdf binary
*.docx binary
*.wasm binary
*.traineddata binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dmg binary
*.zip binary
*.7z binary

# ESLint / Prettier 配置快照（若存在）
.eslintrc* text eol=lf
.prettierrc* text eol=lf